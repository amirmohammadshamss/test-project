generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum AuditActorType {
  RESTAURANT_USER
  PLATFORM_ADMIN
  ANONYMOUS
}

enum Role {
  MANAGER
  WAITER
  KITCHEN
}

enum OrderStatus {
  CANCELLED
  OPEN
  COMPLETED
}

enum ItemStatus {
  CANCELLED
  PENDING
  PREPARING
  READY
  SERVED
}

enum DraftStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  APPROVED
}

model Restaurant {
  id                   String                 @id @default(uuid()) @db.Uuid
  name                 String
  status               TenantStatus           @default(ACTIVE)
  version              Int                    @default(1)
  provisioningKey      String?                @unique
  primaryContact       String                 @default("")
  contactEmail         String                 @default("")
  phone                String                 @default("")
  address              String                 @default("")
  currencyPresentation String                 @default("TOMAN")
  timezone             String                 @default("Asia/Tehran")
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  branches             Branch[]
  memberships          Membership[]
  categories           Category[]
  menuItems            MenuItem[]
  drafts               AiDraft[]
  adminAuditLogs       AdminAuditLog[]
  lifecycleEvents      TenantLifecycleEvent[]
}

model Branch {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  name       String
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  restaurant Restaurant         @relation(fields: [tenantId], references: [id])
  access     BranchMembership[]
  tables     RestaurantTable[]

  @@unique([tenantId, id])
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  name               String
  passwordHash       String
  active             Boolean             @default(true)
  restaurantSessions RestaurantSession[]
  platformAdmin      PlatformAdmin?
  memberships        Membership[]
  adminAuditLogs     AdminAuditLog[]
}

model Membership {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  userId     String             @db.Uuid
  role       Role
  active     Boolean            @default(true)
  restaurant Restaurant         @relation(fields: [tenantId], references: [id])
  user       User               @relation(fields: [userId], references: [id])
  branches   BranchMembership[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
}

model BranchMembership {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  membershipId String     @db.Uuid
  branchId     String     @db.Uuid
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  branch       Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([membershipId, branchId])
}

model RestaurantTable {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  branchId String  @db.Uuid
  number   Int
  seats    Int     @default(4)
  active   Boolean @default(true)
  version  Int     @default(1)
  branch   Branch  @relation(fields: [tenantId, branchId], references: [tenantId, id])
  orders   Order[]

  @@unique([tenantId, branchId, id])
  @@unique([branchId, number])
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  name         String
  active       Boolean    @default(true)
  displayOrder Int        @default(0)
  version      Int        @default(1)
  restaurant   Restaurant @relation(fields: [tenantId], references: [id])
  items        MenuItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model MenuItem {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  categoryId    String      @db.Uuid
  name          String
  description   String
  priceRial     Int
  active        Boolean     @default(true)
  available     Boolean     @default(true)
  version       Int         @default(1)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  restaurant    Restaurant  @relation(fields: [tenantId], references: [id])
  category      Category    @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  orderedItems  OrderItem[]
  approvedDraft AiDraft?

  @@unique([tenantId, id])
}

model Order {
  cancelledAt             DateTime?       @db.Timestamptz(3)
  cancelledBy             String?         @db.Uuid
  cancellationReason      String?
  cancellationPriorStatus String?
  id                      String          @id @default(uuid()) @db.Uuid
  tenantId                String          @db.Uuid
  branchId                String          @db.Uuid
  tableId                 String          @db.Uuid
  status                  OrderStatus     @default(OPEN)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  completedAt             DateTime?       @db.Timestamptz(3)
  table                   RestaurantTable @relation(fields: [tenantId, branchId, tableId], references: [tenantId, branchId, id])
  items                   OrderItem[]
  events                  OrderEvent[]

  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, status])
}

model OrderItem {
  cancelledAt             DateTime?  @db.Timestamptz(3)
  cancelledBy             String?    @db.Uuid
  cancellationReason      String?
  cancellationPriorStatus String?
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @db.Uuid
  branchId                String     @db.Uuid
  orderId                 String     @db.Uuid
  menuItemId              String     @db.Uuid
  name                    String
  priceRial               Int
  quantity                Int
  status                  ItemStatus @default(PENDING)
  version                 Int        @default(1)
  createdAt               DateTime   @default(now()) @db.Timestamptz(3)
  order                   Order      @relation(fields: [tenantId, branchId, orderId], references: [tenantId, branchId, id])
  menuItem                MenuItem   @relation(fields: [tenantId, menuItemId], references: [tenantId, id])

  @@index([tenantId, branchId, status])
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  orderId   String   @db.Uuid
  actorId   String   @db.Uuid
  action    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order     Order    @relation(fields: [tenantId, branchId, orderId], references: [tenantId, branchId, id])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorId     String   @db.Uuid
  operation   String
  key         String
  fingerprint String
  status      String   @default("COMPLETED")
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([tenantId, actorId, operation, key])
  @@index([expiresAt])
}

model AiDraft {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  actorId    String      @db.Uuid
  input      String
  status     DraftStatus @default(PENDING)
  result     Json?
  errorCode  String?
  attempts   Int         @default(0)
  leaseUntil DateTime?   @db.Timestamptz(3)
  leaseToken String?
  menuItemId String?     @unique @db.Uuid
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  restaurant Restaurant  @relation(fields: [tenantId], references: [id])
  menuItem   MenuItem?   @relation(fields: [tenantId, menuItemId], references: [tenantId, id])

  @@unique([tenantId, menuItemId])
  @@index([tenantId, status])
}

model PlatformAdmin {
  id                 String                      @id @default(uuid()) @db.Uuid
  userId             String                      @unique @db.Uuid
  active             Boolean                     @default(true)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  user               User                        @relation(fields: [userId], references: [id])
  sessions           PlatformSession[]
  idempotencyRecords PlatformIdempotencyRecord[]
}

model PlatformSession {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  revokedAt DateTime?     @db.Timestamptz(3)
  admin     PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId, expiresAt])
}

model AdminAuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorId      String?        @db.Uuid
  actorType    AuditActorType
  tenantId     String?        @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  outcome      String         @default("SUCCESS")
  reason       String?
  metadata     Json?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  actor  User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenant Restaurant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorType, createdAt])
}

model TenantLifecycleEvent {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  actorId    String        @db.Uuid
  fromStatus TenantStatus?
  toStatus   TenantStatus
  reason     String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  tenant Restaurant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model PlatformIdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  principalId String   @db.Uuid
  operation   String
  key         String
  fingerprint String
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  principal PlatformAdmin @relation(fields: [principalId], references: [id])

  @@unique([principalId, operation, key])
  @@index([expiresAt])
}

model RestaurantSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  membershipId String    @db.Uuid
  branchId     String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}
