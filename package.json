{
  "name": "restaurant-os",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nx run-many -t dev -p api,worker,web --parallel=3",
    "build": "nx run-many -t build -p api,worker,web",
    "lint": "nx run workspace:lint",
    "format": "nx run workspace:format",
    "format:check": "nx run workspace:format-check",
    "typecheck": "nx run-many -t typecheck -p api,worker,web",
    "test": "nx run-many -t test -p api,worker,web",
    "test:integration": "nx run workspace:test-integration",
    "test:e2e": "nx run workspace:test-integration",
    "db:generate": "nx run database:generate",
    "db:migrate": "nx run database:migrate",
    "db:seed": "nx run database:seed",
    "prepare": "husky",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "nx": "nx",
    "graph": "nx graph"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.0",
    "nx": "24.0.2",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "nx": {
    "includedScripts": []
  }
}
