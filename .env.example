DATABASE_URL=postgresql://restaurantos:CHANGE_ME@localhost:5432/restaurantos
REDIS_URL=redis://localhost:6379
JWT_SECRET=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PORT=4000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SEED_DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
NODE_ENV=development
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
TEST_DATABASE_URL=postgresql://restaurantos:CHANGE_ME@localhost:5432/restaurantos_test
# false only for localhost HTTP; set true behind HTTPS in deployment.
COOKIE_SECURE=false
# Set a real DNS hostname only when using docker-compose.https.yml.
PUBLIC_HOSTNAME=restaurant.example.com

PLATFORM_ORIGIN=http://localhost:3001
# Controlled local seed only; never enable for production.
ENABLE_PLATFORM_DEMO=false
PLATFORM_DEMO_PASSWORD=REPLACE_WITH_12_OR_MORE_CHARACTERS
PUBLIC_PLATFORM_HOSTNAME=platform.example.com

# Privileged API disabled by default in production; platform UI uses Compose profile platform.
PLATFORM_ADMIN_ENABLED=false

# Optional system Push. Private VAPID key belongs only to the worker.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_ENCRYPTION_KEY=
NOTIFICATION_DELAY_MINUTES=20

# AI is optional and disabled unless explicitly selected: disabled | ollama | openai.
AI_PROVIDER=disabled
AI_PROVIDER_ELIGIBILITY_CONFIRMED=false
AI_DAILY_REQUEST_LIMIT=20
# Self-hosted endpoint configured by operators, never supplied by a browser.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
