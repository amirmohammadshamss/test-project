{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.json",
      {
        "runtime": "node --version"
      }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "backend": [
      "{workspaceRoot}/apps/api/**/*",
      "{workspaceRoot}/apps/worker/**/*",
      "{workspaceRoot}/packages/**/*",
      "sharedGlobals"
    ],
    "workspaceSources": [
      "{workspaceRoot}/apps/**/*",
      "{workspaceRoot}/packages/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/*.cjs",
      "{workspaceRoot}/*.mjs",
      "{workspaceRoot}/project.json",
      "sharedGlobals"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "env": "NODE_ENV"
        }
      ]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/jest.config.cjs"],
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "start": {
      "cache": false,
      "continuous": true
    }
  }
}
